# Reference for backend/src/main.ts (values are read from the environment).
# Without MONGO_URL the API runs on in-memory adapters (nothing to install, data lost on restart).
MONGO_URL=mongodb://localhost:27017/procurement?replicaSet=rs0
# HS256 signing key for access tokens, 32+ characters. Use a secret manager in real deployments.
JWT_SECRET=change-me-to-a-long-random-string-0123456789
PORT=3000
SEED_DEMO=true
