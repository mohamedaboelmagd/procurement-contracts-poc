{
  "name": "procurement-contracts-services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Procurement & contracts services: identity, sourcing (RFx), contracts & change orders \u2014 Express + MongoDB modular monolith",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:api": "vitest run test/api",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
